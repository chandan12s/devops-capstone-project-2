pipeline {
    agent any

    environment {
        DOCKER_HUB_CREDS  = credentials('dockerhub-credentials')
        DOCKER_HUB_USER   = "${DOCKER_HUB_CREDS_USR}"
        IMAGE_NAME_API    = "${DOCKER_HUB_CREDS_USR}/analytics-api"
        IMAGE_NAME_PROC   = "${DOCKER_HUB_CREDS_USR}/analytics-processor"
        IMAGE_TAG         = "${BUILD_NUMBER}"
        KUBECONFIG        = "${HOME}/.kube/config-enterprise"
        K8S_NAMESPACE     = "analytics"
        K8S_NODE_IP       = sh(
                              script: "grep 'server:' ${HOME}/.kube/config-enterprise | sed 's|.*https://||' | sed 's|:6443||' | tr -d ' '",
                              returnStdout: true
                            ).trim()
    }

    stages {

        stage('Checkout') {
            steps {
                echo "=== Checking out source ==="
                checkout scm
                sh 'git log --oneline -3'
            }
        }

        stage('Test') {
            steps {
                echo "=== Running Python unit tests ==="
                sh '''
                    pip3 install -r product-docker/app/api/requirements.txt \
                        --quiet --break-system-packages
                    python3 -m pytest product-docker/app/api/test_app.py \
                        -v --tb=short
                '''
            }
            post {
                failure {
                    error "Tests failed — pipeline halted."
                }
            }
        }

        stage('Build Docker images') {
            steps {
                echo "=== Building images (tag: ${IMAGE_TAG}) ==="
                dir('product-docker') {
                    sh """
                        docker build -f Dockerfile.api \
                            --build-arg APP_VERSION=${IMAGE_TAG} \
                            -t ${IMAGE_NAME_API}:${IMAGE_TAG} \
                            -t ${IMAGE_NAME_API}:latest .

                        docker build -f Dockerfile.processor \
                            -t ${IMAGE_NAME_PROC}:${IMAGE_TAG} \
                            -t ${IMAGE_NAME_PROC}:latest .
                    """
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                sh """
                    echo "${DOCKER_HUB_CREDS_PSW}" | \
                        docker login -u "${DOCKER_HUB_CREDS_USR}" --password-stdin
                    docker push ${IMAGE_NAME_API}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME_API}:latest
                    docker push ${IMAGE_NAME_PROC}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME_PROC}:latest
                    docker logout
                """
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo "=== Deploying build #${IMAGE_TAG} to K8s ==="
                sh """
                    kubectl set image deployment/analytics-api \
                        analytics-api=${IMAGE_NAME_API}:${IMAGE_TAG} \
                        -n ${K8S_NAMESPACE}

                    kubectl set image deployment/analytics-processor \
                        analytics-processor=${IMAGE_NAME_PROC}:${IMAGE_TAG} \
                        -n ${K8S_NAMESPACE}

                    kubectl rollout status deployment/analytics-api \
                        -n ${K8S_NAMESPACE} --timeout=120s

                    kubectl rollout status deployment/analytics-processor \
                        -n ${K8S_NAMESPACE} --timeout=120s
                """
            }
        }

        stage('Smoke test') {
            steps {
                echo "=== Running smoke test against live cluster ==="
                sh """
                    sleep 10

                    echo "Node IP from kubeconfig: ${K8S_NODE_IP}"

                    # Health check must return 200
                    HTTP_CODE=\$(curl -s -o /dev/null -w "%{http_code}" \
                        --connect-timeout 10 \
                        http://${K8S_NODE_IP}:30080/health)

                    echo "Health check returned: \${HTTP_CODE}"

                    if [ "\${HTTP_CODE}" != "200" ]; then
                        echo "Smoke test FAILED — health returned \${HTTP_CODE}"
                        exit 1
                    fi

                    echo "Health check PASSED"

                    # Post a real event and verify 201
                    EVENT_CODE=\$(curl -s -o /dev/null -w "%{http_code}" \
                        --connect-timeout 10 \
                        -X POST http://${K8S_NODE_IP}:30080/api/v1/events \
                        -H "Content-Type: application/json" \
                        -d '{"event_type":"ci_smoke_test","payload":{"build":"${IMAGE_TAG}"}}')

                    echo "Event ingestion returned: \${EVENT_CODE}"

                    if [ "\${EVENT_CODE}" != "201" ]; then
                        echo "Event ingestion FAILED — returned \${EVENT_CODE}"
                        exit 1
                    fi

                    echo "Event ingestion PASSED"
                    echo "=== All smoke tests passed ==="
                """
            }
        }

        stage('Cleanup local images') {
            steps {
                sh """
                    docker rmi ${IMAGE_NAME_API}:${IMAGE_TAG} || true
                    docker rmi ${IMAGE_NAME_PROC}:${IMAGE_TAG} || true
                """
            }
        }
    }

    post {
        success {
            echo "SUCCESS — build #${IMAGE_TAG} deployed and smoke tested."
        }
        failure {
            echo "FAILED at stage: ${env.STAGE_NAME}"
        }
    }
}