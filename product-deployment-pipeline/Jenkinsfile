pipeline {
    agent any

    parameters {
        choice(
            name: 'DEPLOY_ENV',
            choices: ['dev', 'stage', 'prod'],
            description: 'Target deployment environment'
        )
    }

    environment {
        DOCKER_HUB_CREDS  = credentials('dockerhub-credentials')
        SNYK_TOKEN        = credentials('snyk-token')
        VAULT_TOKEN       = credentials('vault-token')
        VAULT_ADDR        = 'http://localhost:8200'
        IMAGE_NAME_API    = "${DOCKER_HUB_CREDS_USR}/analytics-api"
        IMAGE_NAME_PROC   = "${DOCKER_HUB_CREDS_USR}/analytics-processor"
        IMAGE_TAG         = "${BUILD_NUMBER}"
        KUBECONFIG        = "${HOME}/.kube/config-enterprise"
        K8S_NAMESPACE     = "analytics"
        K8S_NODE_IP       = sh(
                              script: "grep 'server:' ${HOME}/.kube/config-enterprise | sed 's|.*https://||' | sed 's|:6443||' | tr -d ' '",
                              returnStdout: true
                            ).trim()
    }

    stages {

        stage('Checkout') {
            steps {
                echo "=== Checking out source ==="
                checkout scm
                sh 'git log --oneline -3'
                echo "Target environment: ${params.DEPLOY_ENV}"
                sh 'mkdir -p ${WORKSPACE}/docs/evidence'
            }
        }

        stage('Test') {
            steps {
                echo "=== Running Python unit tests ==="
                sh '''
                    pip3 install -r product-docker/app/api/requirements.txt \
                        --quiet --break-system-packages
                    python3 -m pytest product-docker/app/api/test_app.py \
                        -v --tb=short
                '''
            }
            post {
                failure {
                    error "Tests failed — pipeline halted."
                }
            }
        }

        stage('Snyk security scan') {
            steps {
                echo "=== Running Snyk vulnerability scan ==="
                sh '''
                    mkdir -p ${WORKSPACE}/docs/evidence
                    pip3 install -r product-docker/app/api/requirements.txt \
                        --quiet --break-system-packages
                    /usr/local/bin/snyk auth ${SNYK_TOKEN}
                    cd product-docker/app/api
                    /usr/local/bin/snyk test \
                        --file=requirements.txt \
                        --package-manager=pip \
                        --command=python3 \
                        --severity-threshold=high \
                        --json \
                        --json-file-output=${WORKSPACE}/docs/evidence/snyk-scan-${BUILD_NUMBER}.json \
                        2>/tmp/snyk-stderr.txt
                    SNYK_EXIT=$?
                    /usr/local/bin/snyk test \
                        --file=requirements.txt \
                        --package-manager=pip \
                        --command=python3 \
                        --severity-threshold=high || true
                    if [ "${SNYK_EXIT}" = "1" ]; then
                        echo "HIGH/CRITICAL vulnerabilities found — halting"
                        exit 1
                    elif [ "${SNYK_EXIT}" = "2" ]; then
                        echo "Snyk error — continuing with warning"
                    else
                        echo "Snyk scan passed"
                    fi
                '''
            }
        }

        stage('Build Docker images') {
            steps {
                echo "=== Building images (tag: ${IMAGE_TAG}) ==="
                dir('product-docker') {
                    sh """
                        docker build -f Dockerfile.api \
                            --build-arg APP_VERSION=${IMAGE_TAG} \
                            -t ${IMAGE_NAME_API}:${IMAGE_TAG} \
                            -t ${IMAGE_NAME_API}:latest .

                        docker build -f Dockerfile.processor \
                            -t ${IMAGE_NAME_PROC}:${IMAGE_TAG} \
                            -t ${IMAGE_NAME_PROC}:latest .
                    """
                }
            }
        }

        stage('Snyk container scan') {
            steps {
                echo "=== Scanning Docker images ==="
                sh """
                    mkdir -p ${WORKSPACE}/docs/evidence
                    /usr/local/bin/snyk container test \
                        ${IMAGE_NAME_API}:${IMAGE_TAG} \
                        --severity-threshold=critical \
                        --json \
                        --json-file-output=${WORKSPACE}/docs/evidence/snyk-container-${BUILD_NUMBER}.json \
                        2>/tmp/snyk-container-stderr.txt || true
                    /usr/local/bin/snyk container test \
                        ${IMAGE_NAME_API}:${IMAGE_TAG} \
                        --severity-threshold=critical || true
                    echo "Container scan complete"
                """
            }
        }

        stage('Push to Docker Hub') {
            steps {
                sh """
                    echo "${DOCKER_HUB_CREDS_PSW}" | \
                        docker login -u "${DOCKER_HUB_CREDS_USR}" --password-stdin
                    docker push ${IMAGE_NAME_API}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME_API}:latest
                    docker push ${IMAGE_NAME_PROC}:${IMAGE_TAG}
                    docker push ${IMAGE_NAME_PROC}:latest
                    docker logout
                """
            }
        }

        stage('Inject secrets from Vault') {
            steps {
                echo "=== Pulling secrets from Vault → K8s ==="
                sh """
                    export VAULT_ADDR=${VAULT_ADDR}
                    export VAULT_TOKEN=${VAULT_TOKEN}
                    bash product-deployment-pipeline/scripts/inject-secrets.sh \
                        ${params.DEPLOY_ENV}
                """
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo "=== Deploying to ${params.DEPLOY_ENV} ==="
                sh """
                    bash product-deployment-pipeline/scripts/deploy-env.sh \
                        ${params.DEPLOY_ENV} ${IMAGE_TAG}
                """
            }
        }

        stage('Smoke test') {
            steps {
                echo "=== Smoke test against ${params.DEPLOY_ENV} ==="
                script {
                    def nodeIp = env.K8S_NODE_IP
                    def buildTag = env.IMAGE_TAG
                    def deployEnv = params.DEPLOY_ENV

                    sh """
                        sleep 10
                        echo "Node IP: ${nodeIp}"

                        HTTP_CODE=\$(curl -s -o /dev/null -w "%{http_code}" \
                            --connect-timeout 10 \
                            http://${nodeIp}:30080/health)

                        echo "Health check: \${HTTP_CODE}"
                        if [ "\${HTTP_CODE}" != "200" ]; then
                            echo "FAILED — health returned \${HTTP_CODE}"
                            exit 1
                        fi
                        echo "Health check PASSED"
                    """

                    // Write JSON payload to a temp file — completely avoids
                    // any shell or Groovy quoting issues with curly braces
                    writeFile file: '/tmp/smoke-payload.json',
                              text: """{"event_type":"ci_smoke_test","payload":{"build":"${buildTag}","env":"${deployEnv}"}}"""

                    sh """
                        echo "Payload:"
                        cat /tmp/smoke-payload.json

                        EVENT_CODE=\$(curl -s -o /dev/null -w "%{http_code}" \
                            --connect-timeout 10 \
                            -X POST http://${nodeIp}:30080/api/v1/events \
                            -H "Content-Type: application/json" \
                            -d @/tmp/smoke-payload.json)

                        echo "Event ingestion: \${EVENT_CODE}"
                        if [ "\${EVENT_CODE}" != "201" ]; then
                            echo "FAILED — event returned \${EVENT_CODE}"
                            exit 1
                        fi

                        echo "=== All smoke tests passed ==="
                        rm -f /tmp/smoke-payload.json
                    """
                }
            }
        }

        stage('Cleanup') {
            steps {
                sh """
                    docker rmi ${IMAGE_NAME_API}:${IMAGE_TAG} || true
                    docker rmi ${IMAGE_NAME_PROC}:${IMAGE_TAG} || true
                """
            }
        }
    }

    post {
        success {
            echo "SUCCESS — build #${IMAGE_TAG} deployed to ${params.DEPLOY_ENV}."
        }
        failure {
            echo "FAILED at stage: ${env.STAGE_NAME}"
        }
    }
}